{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "wishos-connect",
  "main": "worker.ts",
  "compatibility_date": "2026-10-15",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "routes": [
    { "pattern": "mcp.wishos.dev", "custom_domain": true },
    { "pattern": "relay.wishos.dev", "custom_domain": true },
  ],
  "vars": { "PUBLIC_ORIGIN": "https://mcp.wishos.dev", "RELAY_ORIGIN": "https://relay.wishos.dev" },
  "ratelimits": [
    { "name": "PAIR_RATE", "namespace_id": "1001", "simple": { "limit": 10, "period": 60 } },
  ],
  "durable_objects": {
    "bindings": [
      { "name": "DIRECTORY", "class_name": "WishosDirectory" },
      { "name": "ROOMS", "class_name": "WishosRoom" },
    ],
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["WishosDirectory", "WishosRoom"] }],
  "observability": { "enabled": false },
}
